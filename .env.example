# MoodleScout v2 — Template d'environnement
# Copier vers .env.local et remplir les valeurs.

# ── App ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── NextAuth / SSO ──────────────────────────────────────────────
NEXTAUTH_URL=https://votre-domaine.unchk.sn
AUTH_URL=https://votre-domaine.unchk.sn
AUTH_TRUST_HOST=true
# Generer avec : openssl rand -base64 32
AUTH_SECRET=changeme

# ── PostgreSQL ──────────────────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://moodlescoutv2:CHANGEME@127.0.0.1:5432/moodlescoutv2

# ── Redis ───────────────────────────────────────────────────────
# Format : redis://[:PASSWORD]@HOST:PORT/DB_INDEX
REDIS_URL=redis://:CHANGEME@127.0.0.1:6379/2

# ── Keycloak OIDC ───────────────────────────────────────────────
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/REALM
KEYCLOAK_CLIENT_ID=moodlescoutv2
KEYCLOAK_CLIENT_SECRET=changeme

# Direction qui obtient automatiquement le role admin au premier login
# Les autres utilisateurs sont crees avec role=auditeur. Aucun filtre d'acces.
ADMIN_DIRECTION=DITSI

# ── Chiffrement des secrets en base (AES-256-GCM) ───────────────
# Generer avec : openssl rand -hex 32
# ATTENTION : si cette cle change, tous les tokens chiffres seront illisibles.
ENCRYPTION_KEY=changeme

# ── LLM ─────────────────────────────────────────────────────────
OLLAMA_DEFAULT_URL=https://ollama.example.com
OLLAMA_API_KEY=changeme
OLLAMA_DEFAULT_MODEL=gemma3:12b

# ── BullMQ + concurrence ────────────────────────────────────────
BULLMQ_QUEUE_NAME=audit-jobs
# Nombre d'audits (jobs BullMQ) en parallele dans le worker
BULLMQ_CONCURRENCY=3
# Cours traites en parallele a l'interieur d'un meme audit.
# 5 = bon compromis : Moodle WS multiplexe, LLM serialise en aval via LLM_MAX_CONCURRENT.
AUDIT_INTRA_JOB_CONCURRENCY=5
# Slots LLM globaux partages entre TOUS les jobs et tous les cours.
# Pour Ollama mono-GPU (gemma3:12b ~7GB VRAM) : 1.
# Pour Anthropic API : 5-10 selon ton tier.
LLM_MAX_CONCURRENT=1

# ── Comptage utilisateurs Moodle (panneau Détails plateforme) ──
# Méthodes d'auth Moodle interrogées une à une pour sommer les utilisateurs.
# Liste séparée par virgules. Exemple UN-CHK : manual,oidc.
# Si non défini, défaut = manual,oidc.
# MOODLE_AUTH_METHODS=manual,oidc

# ── Logs ────────────────────────────────────────────────────────
LOG_LEVEL=info
